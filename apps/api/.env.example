NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/artopus_learn
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required in production. Verify artopusindia.com in Resend for the fixed OTP sender.
# From: Artopus India <contact@artopusindia.com>. Keep this key server-side.
RESEND_API_KEY=
# Set to the exact number of trusted reverse proxies only when deploying behind one.
TRUST_PROXY_HOPS=0
