{
  "name": "@artopus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "admin:user": "tsx --env-file-if-exists=.env src/scripts/admin-user.ts",
    "content:business": "tsx --env-file-if-exists=.env src/scripts/apply-business-content.ts"
  },
  "dependencies": {
    "@artopus/shared": "0.1.0",
    "bcryptjs": "^3.0.0",
    "cloudinary": "^2.0.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.12.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.5.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0"
  }
}
