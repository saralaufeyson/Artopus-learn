# Copy API values to apps/api/.env and VITE_* values to apps/web/.env.
# All values below are local examples, not production credentials.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/artopus_learn
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=http://localhost:5173

# Administrator OTP sender is fixed to contact@artopusindia.com. Use authorized SMTP credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Set to the exact number of trusted reverse proxies only when deploying behind one.
TRUST_PROXY_HOPS=0
